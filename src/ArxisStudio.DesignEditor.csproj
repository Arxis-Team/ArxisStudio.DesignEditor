<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Avalonia 12 больше не поставляет netstandard2.0-сборки: минимальный TFM — net8.0. -->
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>ArxisStudio</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        Единственный упаковываемый проект решения: тесты и демо отключены
        в Directory.Build.props.

        Версия 0.x осознанно. Публичная поверхность закреплена слепком, но всё ещё
        меняется — этап ядра выделения её уже правил, — а 1.0 обещает обратную
        совместимость, которую сейчас обещать нечем.
    -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>ArxisStudio.DesignEditor</PackageId>
        <Version>0.1.0</Version>
        <Authors>Arxis Team</Authors>
        <Company>Arxis Team</Company>
        <Product>ArxisStudio.DesignEditor</Product>
        <Description>Библиотека контролов Avalonia UI для построения визуальных редакторов, form designer'ов и layout editor'ов: бесконечная поверхность с панорамированием и зумом, фоновая сетка, двухуровневое выделение, перетаскивание и изменение размеров, привязка к сетке и направляющие выравнивания.</Description>
        <PackageTags>avalonia;designer;form-designer;gui-builder;layout-editor;canvas;diagram;ui</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/Arxis-Team/ArxisStudio.DesignEditor</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Arxis-Team/ArxisStudio.DesignEditor.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!--
        Символы отдельным snupkg, а не внутри пакета: иначе .pdb приезжает всем,
        включая тех, кому он не нужен.

        SourceLink с .NET 8 SDK встроен и отдельной ссылки на пакет не требует;
        PublishRepositoryUrl кладёт в сборку адрес репозитория, EmbedUntrackedSources
        добирает файлы, которых нет в git, — без них шаг в такой файл в отладчике
        упирается в ненайденный исходник.
    -->
    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

</Project>
