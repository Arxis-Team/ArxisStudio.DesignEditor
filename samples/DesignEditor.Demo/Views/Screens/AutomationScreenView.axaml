<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesignEditor.Demo.Views.Screens.AutomationScreenView">

    <!-- Редактор сценария. Корень — DockPanel: положение задаётся стороной
         прикрепления, поэтому координаты недоступны, а размер меняется. -->
    <Border Background="#1B1D21" BorderBrush="#2E343B" BorderThickness="1" CornerRadius="10" Padding="18">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,14">
                <TextBlock Text="Сценарий «Ушёл из дома»" FontSize="15" FontWeight="SemiBold"
                           Foreground="#E6E9EF" />
                <TextBlock Text="Срабатывает при уходе последнего жильца" FontSize="11" Foreground="#8A94A6" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Проверить" Background="#22262B" Foreground="#8A94A6"
                        BorderBrush="#2E343B" CornerRadius="7" Padding="14,6" />
                <Button Content="Сохранить" Background="#4C97FF" Foreground="#FFFFFF"
                        BorderThickness="0" CornerRadius="7" Padding="14,6" />
            </StackPanel>

            <StackPanel Spacing="8">

                <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Background="#1E3A5F" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="ЕСЛИ" FontSize="10" FontWeight="SemiBold" Foreground="#8FC1FF" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="никого нет дома дольше 10 минут"
                                   FontSize="12" Foreground="#E6E9EF" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Background="#2F4A32" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="ТО" FontSize="10" FontWeight="SemiBold" Foreground="#8FE0A8" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="выключить свет во всех комнатах"
                                   FontSize="12" Foreground="#E6E9EF" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Background="#2F4A32" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="ТО" FontSize="10" FontWeight="SemiBold" Foreground="#8FE0A8" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="снизить температуру до 18°"
                                   FontSize="12" Foreground="#E6E9EF" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Button Content="+ Добавить действие" HorizontalAlignment="Left"
                        Background="Transparent" Foreground="#4C97FF" BorderThickness="0"
                        Padding="0,6" />

            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
