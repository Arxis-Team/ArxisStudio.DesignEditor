<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesignEditor.Demo.Views.Screens.ThermostatScreenView">

    <!-- Экран устройства. Корень — StackPanel: позицию задаёт поток,
         поэтому редактор предлагает перестановку, а не координаты. -->
    <Border Background="#1B1D21" BorderBrush="#2E343B" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="16">

            <StackPanel Spacing="2">
                <TextBlock Text="Термостат" FontSize="17" FontWeight="SemiBold" Foreground="#E6E9EF" />
                <TextBlock Text="Гостиная · онлайн" FontSize="11" Foreground="#48C78E" />
            </StackPanel>

            <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="21" FontSize="44" FontWeight="Light" Foreground="#E6E9EF" />
                        <TextBlock Text="°C" FontSize="16" Foreground="#8A94A6" VerticalAlignment="Top"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                    <TextBlock Text="Целевая 23°" FontSize="11" Foreground="#8A94A6" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Целевая температура" FontSize="11" Foreground="#8A94A6" />
                <Slider Value="23" Minimum="16" Maximum="30" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Режим" FontSize="11" Foreground="#8A94A6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#4C97FF" CornerRadius="8" Padding="14,7">
                        <TextBlock Text="Нагрев" FontSize="11" Foreground="#FFFFFF" />
                    </Border>
                    <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1" CornerRadius="8" Padding="14,7">
                        <TextBlock Text="Охлаждение" FontSize="11" Foreground="#8A94A6" />
                    </Border>
                    <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1" CornerRadius="8" Padding="14,7">
                        <TextBlock Text="Авто" FontSize="11" Foreground="#8A94A6" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border Background="#22262B" CornerRadius="10" Padding="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Расписание" FontSize="12" Foreground="#E6E9EF" />
                        <TextBlock Text="Будни · 06:30 — 23:00" FontSize="11" Foreground="#8A94A6" />
                    </StackPanel>
                    <ToggleSwitch OnContent="" OffContent="" Grid.Column="1" IsChecked="True" />
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
