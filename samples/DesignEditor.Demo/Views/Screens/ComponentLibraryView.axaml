<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesignEditor.Demo.Views.Screens.ComponentLibraryView">

    <!-- Библиотека контролов, из которых собраны экраны.
         Корень — WrapPanel: положение задаёт поток, значит перестановка. -->
    <Border Background="#1B1D21" BorderBrush="#2E343B" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="14">

            <TextBlock Text="Компоненты" FontSize="14" FontWeight="SemiBold" Foreground="#E6E9EF" />

            <WrapPanel Orientation="Horizontal" ItemWidth="220" ItemHeight="72">

                <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Переключатель" FontSize="12" Foreground="#E6E9EF" />
                            <TextBlock Text="устройство вкл/выкл" FontSize="10" Foreground="#8A94A6" />
                        </StackPanel>
                        <ToggleSwitch OnContent="" OffContent="" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Яркость" FontSize="12" Foreground="#E6E9EF" />
                        <Slider Value="70" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Статус" FontSize="12" Foreground="#E6E9EF" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#2F4A32" CornerRadius="10" Padding="9,3">
                                <TextBlock Text="онлайн" FontSize="10" Foreground="#8FE0A8" />
                            </Border>
                            <Border Background="#4A3520" CornerRadius="10" Padding="9,3">
                                <TextBlock Text="батарея" FontSize="10" Foreground="#F2C037" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#22262B" BorderBrush="#2E343B" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Показание датчика" FontSize="12" Foreground="#E6E9EF" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="46" FontSize="18" FontWeight="SemiBold" Foreground="#E6E9EF" />
                            <TextBlock Text="% влажности" FontSize="10" Foreground="#8A94A6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
