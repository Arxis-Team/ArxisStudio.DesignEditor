<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesignEditor.Demo.Views.Screens.AddDeviceDialogView">

    <!-- Диалог. Корень — Grid: положением полей распоряжается сетка,
         поэтому перетаскивание им недоступно, а размер меняется. -->
    <Border Background="#1B1D21" BorderBrush="#2E343B" BorderThickness="1" CornerRadius="10" Padding="20">
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Новое устройство"
                       FontSize="16" FontWeight="SemiBold" Foreground="#E6E9EF" Margin="0,0,0,18" />

            <TextBlock Grid.Row="1" Text="Название" FontSize="11" Foreground="#8A94A6"
                       VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="Например, торшер"
                     Background="#22262B" Foreground="#E6E9EF" BorderBrush="#2E343B"
                     CornerRadius="7" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Text="Тип" FontSize="11" Foreground="#8A94A6"
                       VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                      SelectedIndex="0" Background="#22262B" Foreground="#E6E9EF"
                      BorderBrush="#2E343B" CornerRadius="7" Margin="0,0,0,10">
                <ComboBoxItem Content="Освещение" />
                <ComboBoxItem Content="Розетка" />
                <ComboBoxItem Content="Датчик" />
            </ComboBox>

            <TextBlock Grid.Row="3" Text="Комната" FontSize="11" Foreground="#8A94A6"
                       VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                      SelectedIndex="0" Background="#22262B" Foreground="#E6E9EF"
                      BorderBrush="#2E343B" CornerRadius="7" Margin="0,0,0,10">
                <ComboBoxItem Content="Гостиная" />
                <ComboBoxItem Content="Спальня" />
                <ComboBoxItem Content="Кухня" />
            </ComboBox>

            <CheckBox Grid.Row="4" Grid.Column="1" Content="Добавить на главный экран"
                      Foreground="#8A94A6" IsChecked="True" VerticalAlignment="Top" />

            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8">
                <Button Content="Отмена" Background="#22262B" Foreground="#8A94A6"
                        BorderBrush="#2E343B" CornerRadius="7" Padding="16,7" />
                <Button Content="Добавить" Background="#4C97FF" Foreground="#FFFFFF"
                        BorderThickness="0" CornerRadius="7" Padding="16,7" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
